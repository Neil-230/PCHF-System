# Backend Environment Variables Template
# Copy this file to .env and fill in your actual values

# Server
PORT=4000
NODE_ENV=development

# Base URLs
BACKEND_BASE_URL=http://localhost:4000

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=YourApp

# JWT
JWT_SECRET=your-256-character-random-secret-key-here-min-32-chars
JWT_EXPIRE=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Google Drive
DRIVE_CLIENT_ID=your-drive-client-id.apps.googleusercontent.com
DRIVE_CLIENT_SECRET=your-drive-client-secret
DRIVE_REDIRECT_URL=http://localhost:4000/api/settings/drive/callback

# Facebook OAuth
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=http://localhost:4000/api/auth/facebook/callback

# reCAPTCHA
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Email Service (Gmail SMTP)
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_FROM=noreply@yourdomain.com

# Frontend URL
FRONTEND_URL=http://localhost:5173

# SMS Twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM=YourApp

# IP Intelligence
IPINFO_TOKEN=your-ipinfo-token
